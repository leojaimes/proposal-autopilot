# ==============================================================================
# PROPOSAL AUTOPILOT - PLANTILLA DE VARIABLES DE ENTORNO PARA DESARROLLO LOCAL
# Copia este archivo como .env en backend/ y ajusta según tu entorno local
# ==============================================================================

PORT=7000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5438/proposal_autopilot_db?schema=public

# Credenciales Apify
APIFY_TOKEN=apify_api_tu_token_aqui

# Motores de Inteligencia Artificial
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=tu_anthropic_key_aqui

# Seguridad & Multi-Tenancy
JWT_SECRET=super_secret_jwt_proposal_autopilot_2026
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Gotenberg PDF Generation Service
GOTENBERG_URL=https://pepper-tix-gotenberg.zh4nwb.easypanel.host/forms/chromium/convert/html

# Proveedores de Scraping Habilitados (En desarrollo puedes probar ambos)
ENABLED_SCRAPING_PROVIDERS=UPWORK,LINKEDIN

# Market Radar operations
MARKET_RADAR_RETENTION_DAYS=180
MARKET_RADAR_STALE_AFTER_DAYS=2

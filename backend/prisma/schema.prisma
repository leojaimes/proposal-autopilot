datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StrategicLane {
  CORE_AI_UX
  PRODUCT_STRATEGY
  INTERFACE_BUILD
  UX_RESEARCH
  DISQUALIFIED_NOISE
}

enum DeliveryArchetype {
  PRODUCT_DEFINITION_0_TO_1
  DESIGN_SYSTEM_ARCHITECTURE
  HEURISTIC_AUDIT_RESEARCH
  AD_HOC_EXECUTION
  TEACHING_OR_CONTENT
}

enum FitTier {
  HIGH
  MEDIUM
  LOW
}

enum JobStatus {
  NEEDS_REVIEW
  APPROVED
  APPLIED
  SKIPPED
}

enum BudgetType {
  HOURLY
  FIXED
  NOT_SHOWN
}

enum MarketTaxonomySource {
  UPWORK
  CUSTOM
}

enum MarketTaxonomyKind {
  CATEGORY
  SUBCATEGORY
  OCCUPATION
  SKILL
}

enum MarketCategoryLane {
  CORE
  ADJACENT
  EXCLUDED
}

enum ProfileEligibility {
  ELIGIBLE
  EXCLUDED
  PENDING
}

enum MarketAiLeverageState {
  APPLICABLE
  NOT_APPLICABLE
}

enum JobCategoryAssignmentSource {
  UPWORK
  RULES
  AI
  MANUAL
}

enum TaxonomyClassificationState {
  PENDING
  CLASSIFIED
  FALLBACK
  FAILED
}

enum TaxonomyClassificationWorkStatus {
  PENDING
  PROCESSING
  RETRYING
  COMPLETED
  FAILED
}

enum MarketRadarDecisionStatus {
  PRIORITIZED
  WATCHED
  DISMISSED
}

model Tenant {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @db.VarChar(100)
  slug                  String   @unique @db.VarChar(50)
  upworkProfileUrl      String?  @map("upwork_profile_url")
  baseHourlyRate        Decimal? @default(65.00) @map("base_hourly_rate") @db.Decimal(10, 2)
  monthlyConnectsBudget Int      @default(150) @map("monthly_connects_budget")
  profileCatalogVersion Int      @default(0) @map("profile_catalog_version")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users                       TenantUser[]
  credentials                 TenantCredential[]
  positioningProfiles         PositioningProfile[]
  scrapeConfigs               ScrapeConfig[]
  batchRuns                   BatchRun[]
  jobPosts                    JobPost[]
  taxonomyClassificationWork  TaxonomyClassificationWork[]
  profileCategoryPolicies     ProfileCategoryPolicy[]
  jobCategoryAssignments      JobCategoryAssignment[]
  marketCategorySnapshots     MarketCategorySnapshot[]
  profileOpportunitySnapshots ProfileOpportunitySnapshot[]
  marketRadarDecisions        MarketRadarDecision[]
  prospectedBusinesses        ProspectedBusiness[]
  prospectedBusinessPains     ProspectedBusinessPain[]
  prospectContactLogs         ProspectContactLog[]
  businessContacts            ProspectedBusinessContact[]
  businessSocials             ProspectedBusinessSocial[]

  @@map("tenants")
}

model TenantUser {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("OWNER") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_users")
}

model TenantCredential {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  provider         String    @db.VarChar(30) // APIFY, ANTHROPIC, GOOGLE_DOCS
  encryptedPayload String    @map("encrypted_payload") @db.Text
  isHealthy        Boolean   @default(true) @map("is_healthy")
  lastValidatedAt  DateTime? @map("last_validated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider], name: "uq_tenant_provider")
  @@map("tenant_credentials")
}

model PositioningProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  personaName         String   @default("Consultor") @map("persona_name") @db.VarChar(150)
  roleTitle           String   @default("Consultor") @map("role_title") @db.VarChar(255)
  offerHeadline       String   @map("offer_headline") @db.Text
  targetAudience      String   @map("target_audience") @db.Text
  voiceRules          Json     @default("[]") @map("voice_rules")
  searchKeywords      String[] @default([]) @map("search_keywords")
  minBudgetFixed      Decimal? @default(1000.00) @map("min_budget_fixed") @db.Decimal(10, 2)
  minHourlyRate       Decimal? @default(40.00) @map("min_hourly_rate") @db.Decimal(10, 2)
  verifiedPaymentOnly Boolean  @default(true) @map("verified_payment_only")
  weightSkill         Int      @default(40) @map("weight_skill")
  weightAi            Int      @default(25) @map("weight_ai")
  weightClient        Int      @default(20) @map("weight_client")
  weightRecency       Int      @default(15) @map("weight_recency")
  targetCountries     String[] @default([]) @map("target_countries")
  targetRegions       String[] @default([]) @map("target_regions")
  excludedCountries   String[] @default([]) @map("excluded_countries")
  geoFilterMode       String   @default("WEIGHTED_PREFERENCE") @map("geo_filter_mode") @db.VarChar(30)
  coreRoles           String[] @default([]) @map("core_roles")
  hybridRoles         String[] @default([]) @map("hybrid_roles")
  tangentialRoles     String[] @default([]) @map("tangential_roles")
  excludedRoles       String[] @default([]) @map("excluded_roles")
  baseCv              Json?    @map("base_cv")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proofStories         ProofStory[]
  fitEvaluations       FitEvaluation[]
  proposals            Proposal[]
  categoryPolicies     ProfileCategoryPolicy[]
  opportunitySnapshots ProfileOpportunitySnapshot[]
  marketRadarDecisions MarketRadarDecision[]

  @@map("positioning_profiles")
}

model ProofStory {
  id                   String   @id @default(uuid()) @db.Uuid
  positioningProfileId String   @map("positioning_profile_id") @db.Uuid
  keyCode              String   @map("key_code") @db.VarChar(50) // PEPPER_AI, META_FINTECH, CISCO
  companyOrProduct     String   @map("company_or_product") @db.VarChar(100)
  impactMetric         String   @map("impact_metric") @db.Text
  description          String   @default("") @db.Text
  domainTags           String[] @map("domain_tags")

  positioningProfile PositioningProfile @relation(fields: [positioningProfileId], references: [id], onDelete: Cascade)

  @@map("proof_stories")
}

model MarketTaxonomyNode {
  id              String               @id @default(uuid()) @db.Uuid
  source          MarketTaxonomySource @default(UPWORK)
  externalId      String?              @map("external_id") @db.VarChar(150)
  slug            String               @unique @db.VarChar(150)
  name            String               @db.VarChar(255)
  kind            MarketTaxonomyKind
  parentId        String?              @map("parent_id") @db.Uuid
  taxonomyVersion Int                  @default(1) @map("taxonomy_version")
  metadata        Json?                @map("metadata")
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  parent          MarketTaxonomyNode?      @relation("MarketTaxonomyHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        MarketTaxonomyNode[]     @relation("MarketTaxonomyHierarchy")
  profilePolicies ProfileCategoryPolicy[]
  jobAssignments  JobCategoryAssignment[]
  marketSnapshots MarketCategorySnapshot[]
  marketRadarDecisions MarketRadarDecision[]

  @@unique([source, externalId], name: "uq_taxonomy_source_external_id")
  @@index([parentId, isActive])
  @@map("market_taxonomy_nodes")
}

model ProfileCategoryPolicy {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  profileId      String             @map("profile_id") @db.Uuid
  taxonomyNodeId String             @map("taxonomy_node_id") @db.Uuid
  lane           MarketCategoryLane @default(ADJACENT)
  includeTerms   String[]           @default([]) @map("include_terms")
  excludeTerms   String[]           @default([]) @map("exclude_terms")
  priority       Int                @default(0)
  aiLeverageEnabled Boolean         @default(false) @map("ai_leverage_enabled")
  isActive       Boolean            @default(true) @map("is_active")
  policyVersion  Int                @default(1) @map("policy_version")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile      PositioningProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  taxonomyNode MarketTaxonomyNode @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)

  @@unique([profileId, taxonomyNodeId], name: "uq_profile_taxonomy_policy")
  @@index([tenantId, isActive])
  @@map("profile_category_policies")
}

model ScrapeConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  searchKeywords      String[] @map("search_keywords")
  minBudgetFixed      Decimal? @default(500.00) @map("min_budget_fixed") @db.Decimal(10, 2)
  minHourlyRate       Decimal? @default(40.00) @map("min_hourly_rate") @db.Decimal(10, 2)
  recencyDays         Int      @default(3) @map("recency_days")
  verifiedPaymentOnly Boolean  @default(true) @map("verified_payment_only")
  targetCountries     String[] @default([]) @map("target_countries")
  targetRegions       String[] @default([]) @map("target_regions")
  excludedCountries   String[] @default([]) @map("excluded_countries")
  geoFilterMode       String   @default("WEIGHTED_PREFERENCE") @map("geo_filter_mode") @db.VarChar(30)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("scrape_configs")
}

model BatchRun {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  jobsFound      Int       @default(0) @map("jobs_found")
  highFitCount   Int       @default(0) @map("high_fit_count")
  mediumFitCount Int       @default(0) @map("medium_fit_count")
  status         String    @default("RUNNING") @db.VarChar(20)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobPosts JobPost[]

  @@map("batch_runs")
}

model JobPost {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  batchRunId        String?    @map("batch_run_id") @db.Uuid
  externalUpworkId  String     @map("external_upwork_id") @db.VarChar(100)
  title             String     @db.VarChar(255)
  description       String     @db.Text
  budgetType        BudgetType @default(NOT_SHOWN) @map("budget_type")
  budgetFixed       Decimal?   @map("budget_fixed") @db.Decimal(10, 2)
  hourlyMin         Decimal?   @map("hourly_min") @db.Decimal(10, 2)
  hourlyMax         Decimal?   @map("hourly_max") @db.Decimal(10, 2)
  rawBudgetText     String?    @map("raw_budget_text") @db.VarChar(100)
  clientCountry     String?    @map("client_country") @db.VarChar(100)
  clientRating      Decimal?   @default(0) @map("client_rating") @db.Decimal(3, 2)
  clientTotalSpend  Decimal?   @default(0) @map("client_total_spend") @db.Decimal(12, 2)
  proposalsCount    Int        @default(0) @map("proposals_count")
  proposalsCountKnown Boolean  @default(false) @map("proposals_count_known")
  isPaymentVerified Boolean    @default(false) @map("is_payment_verified")
  paymentVerificationKnown Boolean @default(false) @map("payment_verification_known")
  jobUrl            String     @map("job_url") @db.Text
  postedAt          DateTime   @map("posted_at")
  postedAtKnown     Boolean    @default(false) @map("posted_at_known")
  status            JobStatus  @default(NEEDS_REVIEW)
  rawApifyPayload   Json?      @map("raw_apify_payload")
  taxonomyClassificationState TaxonomyClassificationState @default(PENDING) @map("taxonomy_classification_state")
  taxonomyClassifierVersion  String? @map("taxonomy_classifier_version") @db.VarChar(50)
  taxonomyFallbackReason     String? @map("taxonomy_fallback_reason") @db.VarChar(100)
  taxonomyClassificationError String? @map("taxonomy_classification_error") @db.Text
  taxonomyClassifiedAt       DateTime? @map("taxonomy_classified_at")
  createdAt         DateTime   @default(now()) @map("created_at")

  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchRun            BatchRun?                   @relation(fields: [batchRunId], references: [id], onDelete: SetNull)
  fitEvaluations      FitEvaluation[]
  proposals           Proposal[]
  categoryAssignments JobCategoryAssignment[]
  taxonomyClassificationWork TaxonomyClassificationWork[]
  snapshotEvidence    MarketSnapshotEvidenceJob[]
  decisionOutcomes    MarketRadarDecisionOutcome[]

  @@unique([tenantId, externalUpworkId], name: "uq_tenant_external_job")
  @@index([tenantId, postedAt(sort: Desc)])
  @@map("job_posts")
}

model SharedUpworkJob {
  id               String   @id @default(uuid()) @db.Uuid
  externalUpworkId String   @unique @map("external_upwork_id") @db.VarChar(100)
  title            String   @db.VarChar(255)
  description      String   @db.Text
  jobUrl           String   @map("job_url") @db.Text
  postedAt         DateTime @map("posted_at")
  rawApifyPayload  Json     @map("raw_apify_payload")
  sourceRunId      String   @map("source_run_id") @db.VarChar(100)
  sourceDatasetId  String   @map("source_dataset_id") @db.VarChar(100)
  sourceKind       SharedUpworkSourceKind @default(HISTORICAL) @map("source_kind")
  sourceActorId    String   @default("hyperbach/upwork-jobs-history") @map("source_actor_id") @db.VarChar(100)
  sourceObservedAt DateTime? @map("source_observed_at")
  sourceSegment    String?  @map("source_segment") @db.VarChar(50)
  isProtected      Boolean  @default(true) @map("is_protected")
  createdAt        DateTime @default(now()) @map("created_at")
  segments         SharedUpworkJobSegment[]

  @@index([sourceKind, postedAt])
  @@index([sourceSegment, postedAt])
  @@map("shared_upwork_jobs")
}

enum SharedUpworkSourceKind {
  HISTORICAL
  LIVE
}

model SharedUpworkJobSegment {
  jobId     String   @map("job_id") @db.Uuid
  segment   String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  job       SharedUpworkJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, segment])
  @@index([segment])
  @@map("shared_upwork_job_segments")
}

model MarketRadarCoverageWindow {
  id            String                    @id @default(uuid()) @db.Uuid
  windowStartAt DateTime                  @map("window_start_at")
  windowEndAt   DateTime                  @map("window_end_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  pages         MarketRadarCoveragePage[]

  @@unique([windowStartAt, windowEndAt])
  @@map("market_radar_coverage_windows")
}

model MarketRadarCoveragePage {
  id               String                    @id @default(uuid()) @db.Uuid
  coverageWindowId String                    @map("coverage_window_id") @db.Uuid
  segment          String                    @db.VarChar(50)
  queryFingerprint String                    @map("query_fingerprint") @db.VarChar(255)
  actorInput       Json?                     @map("actor_input")
  inputCursor      String?                   @map("input_cursor") @db.Text
  outputCursor     String?                   @map("output_cursor") @db.Text
  apifyRunId       String                    @map("apify_run_id") @db.VarChar(100)
  apifyDatasetId   String                    @map("apify_dataset_id") @db.VarChar(100)
  oldestObservedAt DateTime                  @map("oldest_observed_at")
  recordedAt       DateTime                  @default(now()) @map("recorded_at")
  coverageWindow   MarketRadarCoverageWindow @relation(fields: [coverageWindowId], references: [id], onDelete: Cascade)

  @@unique([coverageWindowId, segment, inputCursor])
  @@index([coverageWindowId, segment, recordedAt])
  @@map("market_radar_coverage_pages")
}

model JobCategoryAssignment {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @map("tenant_id") @db.Uuid
  jobPostId         String                      @map("job_post_id") @db.Uuid
  taxonomyNodeId    String                      @map("taxonomy_node_id") @db.Uuid
  source            JobCategoryAssignmentSource @default(UPWORK)
  confidence        Decimal?                    @db.Decimal(5, 4)
  isPrimary         Boolean                     @default(false) @map("is_primary")
  classifierVersion String                      @default("v1") @map("classifier_version") @db.VarChar(50)
  taxonomyVersion   Int                         @default(1) @map("taxonomy_version")
  evidence          Json?                       @map("evidence")
  classifiedAt      DateTime                    @default(now()) @map("classified_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobPost      JobPost            @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  taxonomyNode MarketTaxonomyNode @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)

  @@unique([jobPostId, taxonomyNodeId], name: "uq_job_taxonomy_assignment")
  @@index([tenantId, taxonomyNodeId, classifiedAt])
  @@map("job_category_assignments")
}

/// Durable, tenant-scoped taxonomy work.  The unique key prevents duplicate
/// delivery from creating concurrent work for the same taxonomy revision.
model TaxonomyClassificationWork {
  id              String                           @id @default(uuid()) @db.Uuid
  tenantId        String                           @map("tenant_id") @db.Uuid
  jobPostId       String                           @map("job_post_id") @db.Uuid
  taxonomyVersion Int                              @default(1) @map("taxonomy_version")
  classifierVersion String                         @default("taxonomy-rules-v1") @map("classifier_version") @db.VarChar(50)
  batchId         String?                          @map("batch_id") @db.VarChar(100)
  inputPayload    Json                             @default("{}") @map("input_payload")
  status          TaxonomyClassificationWorkStatus @default(PENDING)
  attempts        Int                              @default(0)
  maxAttempts     Int                              @default(3) @map("max_attempts")
  availableAt     DateTime                         @default(now()) @map("available_at")
  lockedAt        DateTime?                        @map("locked_at")
  lockedBy        String?                          @map("locked_by") @db.VarChar(100)
  lastError       String?                          @map("last_error") @db.Text
  completedAt     DateTime?                        @map("completed_at")
  failedAt        DateTime?                        @map("failed_at")
  createdAt       DateTime                         @default(now()) @map("created_at")
  updatedAt       DateTime                         @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([tenantId, jobPostId, taxonomyVersion], name: "uq_tenant_job_taxonomy_work")
  @@index([tenantId, status, availableAt])
  @@index([batchId, status, availableAt])
  @@map("taxonomy_classification_work")
}

model MarketCategorySnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  taxonomyNodeId     String   @map("taxonomy_node_id") @db.Uuid
  asOf               DateTime @map("as_of") @db.Date
  revision           Int      @default(1)
  isCurrent          Boolean  @default(true) @map("is_current")
  taxonomyVersion    Int      @default(1) @map("taxonomy_version")
  sourceLineage      Json     @default("{}") @map("source_lineage")
  contentHash        String   @default("") @map("content_hash") @db.VarChar(64)
  demand7d           Int      @default(0) @map("demand_7d")
  demand30d          Int      @default(0) @map("demand_30d")
  medianProposals    Decimal? @map("median_proposals") @db.Decimal(10, 2)
  medianBudget       Decimal? @map("median_budget") @db.Decimal(12, 2)
  verifiedClientsPct Decimal? @map("verified_clients_pct") @db.Decimal(5, 2)
  sampleJobs         Int      @default(0) @map("sample_jobs")
  sampleConfidence   Decimal? @map("sample_confidence") @db.Decimal(5, 2)
  metricCoverage     Json     @default("{}") @map("metric_coverage")
  sourceBatchCount   Int      @default(0) @map("source_batch_count")
  calculationVersion String   @default("v1") @map("calculation_version") @db.VarChar(50)
  periodStart        DateTime @map("period_start") @db.Date
  periodEnd          DateTime @map("period_end") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxonomyNode         MarketTaxonomyNode           @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)
  evidenceJobs         MarketSnapshotEvidenceJob[]
  profileOpportunities ProfileOpportunitySnapshot[]
  decisions            MarketRadarDecision[]

  @@unique([tenantId, taxonomyNodeId, asOf, calculationVersion, revision], name: "uq_market_snapshot_revision")
  @@index([tenantId, isCurrent, asOf(sort: Desc)])
  @@map("market_category_snapshots")
}

model MarketSnapshotEvidenceJob {
  snapshotId String @map("snapshot_id") @db.Uuid
  jobPostId  String @map("job_post_id") @db.Uuid

  snapshot MarketCategorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  jobPost  JobPost                @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@id([snapshotId, jobPostId])
  @@index([jobPostId])
  @@map("market_snapshot_evidence_jobs")
}

model ProfileOpportunitySnapshot {
  id                       String             @id @default(uuid()) @db.Uuid
  tenantId                 String             @map("tenant_id") @db.Uuid
  profileId                String?            @map("profile_id") @db.Uuid
  marketCategorySnapshotId String             @map("market_category_snapshot_id") @db.Uuid
  lane                     MarketCategoryLane @default(ADJACENT)
  profileFit               Decimal?           @map("profile_fit") @db.Decimal(5, 2)
  overallOpportunity       Decimal?           @map("overall_opportunity") @db.Decimal(5, 2)
  fitSampleJobs            Int                @default(0) @map("fit_sample_jobs")
  profileEligibility       ProfileEligibility @default(PENDING) @map("profile_eligibility")
  aiLeverageState          MarketAiLeverageState @default(NOT_APPLICABLE) @map("ai_leverage_state")
  aiLeverageCapability     String?            @map("ai_leverage_capability") @db.VarChar(255)
  aiLeverageTask           String?            @map("ai_leverage_task") @db.Text
  aiLeverageExplanation    String?            @map("ai_leverage_explanation") @db.Text
  calculationVersion       String             @default("v1") @map("calculation_version") @db.VarChar(50)
  createdAt                DateTime           @default(now()) @map("created_at")

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile                PositioningProfile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  marketCategorySnapshot MarketCategorySnapshot @relation(fields: [marketCategorySnapshotId], references: [id], onDelete: Cascade)

  @@unique([profileId, marketCategorySnapshotId, calculationVersion], name: "uq_profile_opportunity_snapshot")
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("profile_opportunity_snapshots")
}

model MarketRadarDecision {
  id                       String                    @id @default(uuid()) @db.Uuid
  tenantId                 String                    @map("tenant_id") @db.Uuid
  marketCategorySnapshotId String                    @map("market_category_snapshot_id") @db.Uuid
  positioningProfileId     String?                   @map("positioning_profile_id") @db.Uuid
  taxonomyNodeId           String                    @map("taxonomy_node_id") @db.Uuid
  status                   MarketRadarDecisionStatus
  rationale                String                    @db.Text
  operatorLabel            String                    @map("operator_label") @db.VarChar(150)
  snapshotContext          Json                      @map("snapshot_context")
  profileContext           Json                      @map("profile_context")
  evidenceJobIds           String[]                  @default([]) @map("evidence_job_ids") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshot     MarketCategorySnapshot @relation(fields: [marketCategorySnapshotId], references: [id], onDelete: Restrict)
  profile      PositioningProfile?   @relation(fields: [positioningProfileId], references: [id], onDelete: SetNull)
  taxonomyNode MarketTaxonomyNode    @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)
  outcome      MarketRadarDecisionOutcome?

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([marketCategorySnapshotId])
  @@index([positioningProfileId])
  @@map("market_radar_decisions")
}

model MarketRadarDecisionOutcome {
  id                  String   @id @default(uuid()) @db.Uuid
  marketRadarDecisionId String @unique @map("market_radar_decision_id") @db.Uuid
  jobPostId           String?  @map("job_post_id") @db.Uuid
  proposalId          String?  @map("proposal_id") @db.Uuid
  submittedAt         DateTime? @map("submitted_at")
  qualifiedRepliedAt  DateTime? @map("qualified_replied_at")
  interviewedAt       DateTime? @map("interviewed_at")
  wonAt               DateTime? @map("won_at")
  realizedValue       Decimal?  @map("realized_value") @db.Decimal(12, 2)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  decision MarketRadarDecision @relation(fields: [marketRadarDecisionId], references: [id], onDelete: Cascade)
  jobPost  JobPost?            @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  proposal Proposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([jobPostId])
  @@index([proposalId])
  @@map("market_radar_decision_outcomes")
}

model FitEvaluation {
  id                   String        @id @default(uuid()) @db.Uuid
  jobPostId            String        @map("job_post_id") @db.Uuid
  positioningProfileId String?       @map("positioning_profile_id") @db.Uuid
  status               JobStatus     @default(NEEDS_REVIEW)
  overallScore         Int           @map("overall_score")
  fitTier              FitTier       @map("fit_tier")
  strategicLane        StrategicLane @default(DISQUALIFIED_NOISE) @map("strategic_lane")
  normalizedRole       String        @map("normalized_role") @db.VarChar(100)
  skillScore           Int           @map("skill_score") // 40%
  aiFeasibilityScore   Int           @map("ai_feasibility_score") // 25%
  clientQualityScore   Int           @map("client_quality_score") // 20%
  recencyScore         Int           @map("recency_score") // 15%
  isCapped             Boolean       @default(false) @map("is_capped")
  capReason            String?       @map("cap_reason") @db.VarChar(255)
  summaryRationale     String        @map("summary_rationale") @db.Text
  detectedGaps         String?       @map("detected_gaps") @db.Text
  suggestedProofStory  String?       @map("suggested_proof_story") @db.VarChar(50)
  evaluatedAt          DateTime      @default(now()) @map("evaluated_at")

  jobPost            JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  positioningProfile PositioningProfile? @relation(fields: [positioningProfileId], references: [id], onDelete: SetNull)

  @@unique([jobPostId, positioningProfileId], name: "uq_job_post_profile")
  @@index([overallScore(sort: Desc)])
  @@map("fit_evaluations")
}

model Proposal {
  id                    String    @id @default(uuid()) @db.Uuid
  jobPostId             String    @map("job_post_id") @db.Uuid
  positioningProfileId  String?   @map("positioning_profile_id") @db.Uuid
  contactName           String?   @map("contact_name") @db.VarChar(100)
  coverLetter35Words    String    @map("cover_letter_35_words") @db.Text
  technicalProposalBody String    @map("technical_proposal_body") @db.Text
  mermaidDiagramCode    String?   @map("mermaid_diagram_code") @db.Text
  publicWalkthroughSlug String?   @unique @map("public_walkthrough_slug") @db.VarChar(100)
  googleDocUrl          String?   @map("google_doc_url") @db.Text
  appliedAt             DateTime? @map("applied_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  jobPost            JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  positioningProfile PositioningProfile? @relation(fields: [positioningProfileId], references: [id], onDelete: SetNull)
  decisionOutcomes    MarketRadarDecisionOutcome[]

  @@unique([jobPostId, positioningProfileId], name: "uq_proposal_job_profile")
  @@map("proposals")
}

enum CompanyPainCategory {
  NO_WEBSITE
  WEBSITE_DOWN_OR_EXPIRED
  OUTDATED_OR_SLOW_WEB
  NO_ONLINE_BOOKING
  UNRESPONSIVE_CUSTOMER_SERVICE
  MANUAL_INVENTORY_OR_CATALOG
  LACK_OF_ECOMMERCE
  GENERAL_REPUTATION_ISSUE
}

enum ProspectedLeadStatus {
  DISCOVERED
  AUDITED
  CONTACTED
  DISQUALIFIED
}

enum BusinessOwnershipType {
  INDEPENDENT
  CHAIN_BRANCH
  CORPORATE_HQ
}

enum BusinessOperationalStatus {
  OPERATIONAL
  CLOSED_TEMPORARILY
  CLOSED_PERMANENTLY
  STALE_OR_INACTIVE
}

enum PhoneLineType {
  MOBILE
  LANDLINE
  VOIP
  INVALID
  UNKNOWN
}

enum EmailDeliverabilityStatus {
  UNVERIFIED
  VERIFIED
  CATCH_ALL
  INVALID_BOUNCE
}

enum BusinessPainLifecycleStatus {
  DETECTED
  VERIFIED
  PITCHED
  FALSE_POSITIVE
  DISMISSED
  RESOLVED_BY_US
  RESOLVED_EXTERNALLY
}

enum ContactChannel {
  WHATSAPP
  PHONE_CALL
  EMAIL
  LINKEDIN
  IN_PERSON
}

enum RecipientRole {
  BUSINESS_OWNER
  GATEKEEPER_RECEPTION
  CORPORATE_DECISION_MAKER
  UNKNOWN
}

enum ContactOutcome {
  CONNECTED_PITCHED
  GATEKEEPER_BLOCKED
  NO_ANSWER
  VOICEMAIL
  EMAIL_SENT
  NOT_INTERESTED
  MEETING_SCHEDULED
  CLOSED_WON
  OPT_OUT_BLACKLIST
}

enum EmailDeliveryEvent {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  SPAM_COMPLAINT
}

model CorporateBrand {
  id                   String               @id @default(uuid()) @db.Uuid
  slug                 String               @unique @db.VarChar(150)
  name                 String               @unique @db.VarChar(150)
  rootDomain           String?              @unique @map("root_domain") @db.VarChar(180)
  industry             String?              @db.VarChar(100)
  countryScope         String[]             @default([]) @map("country_scope")
  headquartersCity     String?              @map("headquarters_city") @db.VarChar(100)
  corporateWebsite     String?              @map("corporate_website") @db.Text
  corporateLinkedin    String?              @map("corporate_linkedin") @db.Text
  isKnownFranchise     Boolean              @default(false) @map("is_known_franchise")
  totalBranchesTracked Int                  @default(0) @map("total_branches_tracked")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  branches             ProspectedBusiness[]

  @@index([rootDomain])
  @@index([industry])
  @@map("corporate_brands")
}

model CompanyPainCatalog {
  id                      String                   @id @default(uuid()) @db.Uuid
  code                    String                   @unique @db.VarChar(80)
  categoryEnum            CompanyPainCategory?     @map("category_enum")
  name                    String                   @db.VarChar(150)
  description             String?                  @db.Text
  suggestedOffer          String                   @map("suggested_offer") @db.Text
  baseTicketUsd           Decimal                  @default(500.00) @map("base_ticket_usd") @db.Decimal(10, 2)
  monthlyRetainerUsd      Decimal?                 @map("monthly_retainer_usd") @db.Decimal(10, 2)
  priorityWeight          Int                      @default(50) @map("priority_weight")
  pitchTemplateOwner      String                   @map("pitch_template_owner") @db.Text
  pitchTemplateGatekeeper String                   @map("pitch_template_gatekeeper") @db.Text
  pitchTemplateEnterprise String                   @map("pitch_template_enterprise") @db.Text
  detectionRules          Json                     @default("{}") @map("detection_rules")
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  businessPains           ProspectedBusinessPain[]
  contactLogs             ProspectContactLog[]

  @@index([isActive, priorityWeight])
  @@map("company_pain_catalog")
}

model ProspectedBusiness {
  id                   String                    @id @default(uuid()) @db.Uuid
  tenantId             String                    @map("tenant_id") @db.Uuid
  corporateBrandId     String?                   @map("corporate_brand_id") @db.Uuid
  placeId              String?                   @map("place_id") @db.VarChar(255)
  name                 String                    @db.VarChar(255)
  branchIdentifier     String?                   @map("branch_identifier") @db.VarChar(120)
  rootDomain           String?                   @map("root_domain") @db.VarChar(180)
  ownershipType        BusinessOwnershipType     @default(INDEPENDENT) @map("ownership_type")
  operationalStatus    BusinessOperationalStatus @default(OPERATIONAL) @map("operational_status")
  category             String?                   @db.VarChar(150)
  address              String?                   @db.Text
  city                 String?                   @db.VarChar(100)
  state                String?                   @db.VarChar(100)
  country              String?                   @default("Mexico") @db.VarChar(100)
  latitude             Decimal?                  @db.Decimal(10, 7)
  longitude            Decimal?                  @db.Decimal(10, 7)
  websiteUrl           String?                   @map("website_url") @db.Text
  websiteHttpStatus    Int?                      @map("website_http_status")
  websiteCheckedAt     DateTime?                 @map("website_checked_at")
  enrichmentStatus     String                    @default("PENDING") @map("enrichment_status") @db.VarChar(30)
  phone                String?                   @db.VarChar(50)
  phoneE164            String?                   @map("phone_e164") @db.VarChar(30)
  phoneType            PhoneLineType             @default(UNKNOWN) @map("phone_type")
  email                String?                   @db.VarChar(180)
  emailType            String?                   @map("email_type") @db.VarChar(30)
  emailDeliverability  EmailDeliverabilityStatus @default(UNVERIFIED) @map("email_deliverability")
  rating               Decimal?                  @db.Decimal(3, 2)
  reviewsCount         Int                       @default(0) @map("reviews_count")
  lastGoogleReviewAt   DateTime?                 @map("last_google_review_at")
  priceLevel           Int?                      @map("price_level")
  estimatedTicketUsd   Decimal?                  @map("estimated_ticket_usd") @db.Decimal(10, 2)
  status               ProspectedLeadStatus      @default(DISCOVERED)

  // Denormalized primary pain projection (kept synchronized for fast map rendering & backward compatibility)
  primaryPain          CompanyPainCategory?      @map("primary_pain")
  painConfidence       Decimal?                  @map("pain_confidence") @db.Decimal(3, 2)
  painAnalysis         Json?                     @map("pain_analysis")
  suggestedOffer       String?                   @map("suggested_offer") @db.Text
  salesPitchDraft      String?                   @map("sales_pitch_draft") @db.Text

  // Anti-spam & contact cooldown fields
  lastContactedAt      DateTime?                 @map("last_contacted_at")
  contactCooldownUntil DateTime?                 @map("contact_cooldown_until")
  contactAttemptsCount Int                       @default(0) @map("contact_attempts_count")
  doNotContact         Boolean                   @default(false) @map("do_not_contact")
  doNotContactReason   String?                   @map("do_not_contact_reason") @db.Text

  rawGoogleData        Json?                     @map("raw_google_data")

  scannedAt            DateTime                  @default(now()) @map("scanned_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corporateBrand       CorporateBrand?           @relation(fields: [corporateBrandId], references: [id], onDelete: SetNull)
  detectedPains        ProspectedBusinessPain[]
  contactLogs          ProspectContactLog[]
  contacts             ProspectedBusinessContact[]
  socialProfiles       ProspectedBusinessSocial[]

  @@unique([tenantId, placeId], name: "uq_tenant_place")
  @@index([tenantId, city, category])
  @@index([tenantId, ownershipType, status])
  @@index([tenantId, rootDomain])
  @@index([tenantId, phoneType])
  @@index([tenantId, doNotContact, contactCooldownUntil])
  @@map("prospected_businesses")
}

model ProspectedBusinessPain {
  id                    String                      @id @default(uuid()) @db.Uuid
  tenantId              String                      @map("tenant_id") @db.Uuid
  businessId            String                      @map("business_id") @db.Uuid
  painCatalogId         String                      @map("pain_catalog_id") @db.Uuid
  status                BusinessPainLifecycleStatus @default(DETECTED)
  isPrimary             Boolean                     @default(false) @map("is_primary")
  confidence            Decimal                     @default(0.50) @db.Decimal(3, 2)
  adjustedTicketUsd     Decimal?                    @map("adjusted_ticket_usd") @db.Decimal(10, 2)
  evidence              Json?
  customPitchOwner      String?                     @map("custom_pitch_owner") @db.Text
  customPitchGatekeeper String?                     @map("custom_pitch_gatekeeper") @db.Text
  customPitchEnterprise String?                     @map("custom_pitch_enterprise") @db.Text
  dismissReason         String?                     @map("dismiss_reason") @db.Text
  verifiedBy            String?                     @map("verified_by") @db.VarChar(150)
  detectedAt            DateTime                    @default(now()) @map("detected_at")
  resolvedAt            DateTime?                   @map("resolved_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business              ProspectedBusiness          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  painCatalog           CompanyPainCatalog          @relation(fields: [painCatalogId], references: [id], onDelete: Cascade)

  @@unique([businessId, painCatalogId], name: "uq_business_pain_catalog")
  @@index([tenantId, status])
  @@index([businessId, isPrimary])
  @@map("prospected_business_pains")
}

model ProspectContactLog {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  businessId       String              @map("business_id") @db.Uuid
  painCatalogId    String?             @map("pain_catalog_id") @db.Uuid
  contactedBy      String?             @map("contacted_by") @db.VarChar(150)
  channel          ContactChannel
  recipientRole    RecipientRole       @default(UNKNOWN) @map("recipient_role")
  pitchToneUsed    String?             @map("pitch_tone_used") @db.VarChar(30)
  outcome          ContactOutcome
  notes            String?             @db.Text
  nextFollowupDate DateTime?           @map("next_followup_date")

  // Cold email telemetry fields
  emailSubject     String?             @map("email_subject") @db.VarChar(255)
  emailMessageId   String?             @unique @map("email_message_id") @db.VarChar(255)
  emailEvent       EmailDeliveryEvent? @map("email_event")
  openedAt         DateTime?           @map("opened_at")
  clickedAt        DateTime?           @map("clicked_at")
  repliedAt        DateTime?           @map("replied_at")
  bouncedAt        DateTime?           @map("bounced_at")

  contactedAt      DateTime            @default(now()) @map("contacted_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business         ProspectedBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  painCatalog      CompanyPainCatalog? @relation(fields: [painCatalogId], references: [id], onDelete: SetNull)

  @@index([tenantId, businessId, contactedAt])
  @@index([tenantId, channel, outcome])
  @@index([emailMessageId])
  @@map("prospect_contact_logs")
}

model GeoPreset {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique @db.VarChar(120)
  countryCode        String   @map("country_code") @db.VarChar(5)
  countryName        String   @map("country_name") @db.VarChar(100)
  flag               String   @db.VarChar(10)
  state              String   @db.VarChar(100)
  stateCode          String?  @map("state_code") @db.VarChar(10)
  city               String   @db.VarChar(120)
  latitude           Decimal  @db.Decimal(10, 7)
  longitude          Decimal  @db.Decimal(10, 7)
  zoom               Int      @default(13)
  isTactical         Boolean  @default(false) @map("is_tactical")
  category           String?  @db.VarChar(50) // "Industrial", "Comercial", "Financiero", "Tech"
  polygonCoordinates Json?    @map("polygon_coordinates") // Array de [lat, lng] para polígonos tácticos

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([countryCode, state])
  @@index([isTactical])
  @@map("geo_presets")
}



model ProspectedBusinessContact {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  fullName           String   @map("full_name") @db.VarChar(150)
  honorific          String?  @db.VarChar(50)
  titleRole          String?  @map("title_role") @db.VarChar(150)
  email              String?  @db.VarChar(180)
  phone              String?  @db.VarChar(50)
  phoneE164          String?  @map("phone_e164") @db.VarChar(30)
  isPrimary          Boolean  @default(false) @map("is_primary")
  confidence         Decimal  @default(0.80) @db.Decimal(3, 2)
  sourceUrl          String?  @map("source_url") @db.Text
  sourceProvenance   String   @default("ENRICHMENT_LAMBDA") @map("source_provenance") @db.VarChar(50)
  isManuallyVerified Boolean  @default(false) @map("is_manually_verified")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")


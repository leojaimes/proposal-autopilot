  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business ProspectedBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform], name: "uq_business_social_platform")
  @@index([businessId])
  @@map("prospected_business_socials")
}
